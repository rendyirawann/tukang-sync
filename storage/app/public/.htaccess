# Folder unggahan publik (disajikan lewat symlink public/storage).
# Berkas di sini tidak boleh pernah dieksekusi sebagai skrip.
Options -Indexes -ExecCGI

<FilesMatch "(?i)\.(php\d?|phtml|phar|pl|py|cgi|sh|html?|svg|js)$">
    Require all denied
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
