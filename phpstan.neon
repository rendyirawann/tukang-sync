includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - app
    tmpDir: storage/framework/cache/phpstan
    # Tipe dari PHPDoc framework (mis. request() selalu Request) tidak
    # dianggap pasti, supaya pengaman defensif seperti ?-> tidak ditandai.
    treatPhpDocTypesAsCertain: false
